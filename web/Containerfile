# Build from the repository root: podman build -f web/Containerfile -t mottokar-web .
FROM docker.io/library/node:24-slim AS build
WORKDIR /app/web
COPY web/package.json web/package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi
# The only mobile-app files the server and client import.
COPY src/core/types.ts /app/src/core/
COPY src/providers/proton/mappers.ts src/providers/proton/format.ts /app/src/providers/proton/
COPY web/ ./
RUN npm run typecheck && npm run build && npm prune --omit=dev

FROM docker.io/library/node:24-slim
# Runs as root in the container, which rootless Podman maps to your own user. That lets dev
# and prod share the data volume.
ENV NODE_ENV=production PORT=8080 DATA_DIR=/data TZ=Asia/Kuala_Lumpur
WORKDIR /app/web
COPY --from=build /app/src /app/src
COPY --from=build /app/web/package.json ./
COPY --from=build /app/web/node_modules ./node_modules
COPY --from=build /app/web/server ./server
COPY --from=build /app/web/client/dist ./client/dist
VOLUME /data
EXPOSE 8080
CMD ["node_modules/.bin/tsx", "server/index.ts"]
