{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/Users/zack/.cargo/bin/nalar hook claude",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "/Users/zack/.cargo/bin/nalar hook claude",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "/Users/zack/.cargo/bin/nalar hook claude",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/Users/zack/.cargo/bin/nalar hook claude",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|MultiEdit|Write|NotebookEdit"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "/Users/zack/.cargo/bin/nalar hook claude",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/Users/zack/.cargo/bin/nalar hook claude",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "/Users/zack/.cargo/bin/nalar hook claude",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "/Users/zack/.cargo/bin/nalar hook claude",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
